{
  "rewrites": [
    {
      "source": "/column/:slug.html",
      "destination": "/api/moderate-submission?mode=renderColumn&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/moderate-submission?mode=renderSitemap"
    },
    {
      "source": "/share/imadake/:postId",
      "destination": "/api/moderate-submission?mode=renderShareImadake&postId=:postId"
    },
    {
      "source": "/share/shop/:shopId",
      "destination": "/api/moderate-submission?mode=renderShareShop&shopId=:shopId"
    }
  ]
}
